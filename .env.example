# ================================================================
# CTF ATLAS // ENVIRONMENT CONFIGURATION
# ================================================================
# How to use:
# 1. Local development: Copy this file to `.env` or `.env.local`
#    cp .env.example .env
# 2. Vercel deployment: Set these keys in the Vercel Dashboard under:
#    Project Settings -> Environment Variables
# ================================================================

# --- 1. OPERATOR / ADMIN PROFILE (Full Clearance) ---
# Has full clearance to Tool Academy, Lifecycles, Binary Exploitation, Ghidra, ROP
ATLAS_ADMIN_UID=admin
ATLAS_ADMIN_PASSWORD=admin123

# --- 2. CADET / NORMAL USER PROFILE (Foundational Only) ---
# Zero-knowledge profile: filtered navigation (01-12), no reverse/pwn, no tool academy
# Any alert triggered displays "This field is under development."
ATLAS_CADET_UID=cadet
ATLAS_CADET_PASSWORD=cadet123

# --- OPTION A: Multiple Cadet Usernames (Comma-Separated) ---
# If you want multiple usernames to share the cadet password, separate them with commas:
# ATLAS_CADET_UID=cadet, student, analyst, tester

# --- OPTION B: Multiple Cadet Users with Unique Passwords (JSON Format) ---
# If you want multiple users each with their own distinct password, uncomment this:
# ATLAS_CADET_USERS={"alice":"AlicePass123!","bob":"BobPass456!","charlie":"Charlie789!"}

# --- 3. CRYPTOGRAPHIC HMAC SESSION SECRET ---
# Used for HMAC-SHA256 signing of session tokens.
# In production, set this to a random 32+ character secret string.
SESSION_SECRET=atlas_session_vault_secret_hmac_2026
